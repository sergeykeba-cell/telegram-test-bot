{
  "name": "Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-600, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_logs\n    (n8n_execution_id, workflow_name, node_name, error_message, error_stack, input_data)\nVALUES\n    ($1, $2, $3, $4, $5, $6::jsonb)",
        "options": {
          "queryReplacement": "={{ [$json.execution.id, $json.workflow.name, $json.execution.lastNodeExecuted, $json.execution.error.message, $json.execution.error.stack, JSON.stringify($json.execution.data) ] }}"
        }
      },
      "id": "postgres-log-error",
      "name": "Log error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-380, 300],
      "credentials": {
        "postgres": { "id": "1", "name": "Postgres account" }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.ADMIN_TG_ID }}",
        "text": "=⚠️ Workflow error in *{{ $json.workflow.name }}*\nNode: {{ $json.execution.lastNodeExecuted }}\n{{ $json.execution.error.message }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-alert-admin",
      "name": "Alert admin (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-160, 300],
      "credentials": {
        "telegramApi": { "id": "2", "name": "Telegram account" }
      }
    }
  ],
  "connections": {
    "Error Trigger": { "main": [[{ "node": "Log error", "type": "main", "index": 0 }]] },
    "Log error": { "main": [[{ "node": "Alert admin (Telegram)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
