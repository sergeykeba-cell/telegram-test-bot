{
  "name": "Test Result Processing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "submit-test",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1400, 300],
      "webhookId": "submit-test"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.token, t.doctor_id, t.full_name, t.test_type, t.status, t.expires_at, d.telegram_id\nFROM tokens t\nJOIN doctors d ON d.id = t.doctor_id\nWHERE t.token = $1\n  AND t.status = 'pending'\n  AND t.expires_at > NOW()",
        "options": {
          "queryReplacement": "={{ [$json.body.token] }}"
        }
      },
      "id": "postgres-validate",
      "name": "Validate Token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-1180, 300],
      "credentials": {
        "postgres": { "id": "1", "name": "Postgres account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.token }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-token-valid",
      "name": "Token valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-960, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"invalid_or_expired_token\" } }}",
        "options": { "responseCode": 410 }
      },
      "id": "respond-invalid",
      "name": "Respond: invalid token",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-760, 460]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.test_type }}", "rightValue": "pcl5", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "pcl5" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.test_type }}", "rightValue": "minmult", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "minmult" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.test_type }}", "rightValue": "schmishek", "operator": { "type": "string", "operation": "equals" } }] }, "outputKey": "schmishek" }
          ]
        },
        "options": {}
      },
      "id": "switch-test-type",
      "name": "Determine test type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-760, 220]
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# TODO: real PCL-5 scoring.\n# PCL-5 is a published 20-item instrument (0-4 per item, 0-80 total).\n# The severity cutoffs and item weighting used in the original workflow\n# were never committed to this repo (see issue #1) -- do not ship this\n# placeholder to real respondents until it's replaced with the actual\n# validated scoring logic.\nanswers = _input.first().json.get('answers', {})\n\nscore = sum(int(v) for v in answers.values()) if answers else 0\n\nif score < 20:\n    severity = 'low'\nelif score < 33:\n    severity = 'moderate'\nelif score < 50:\n    severity = 'high'\nelse:\n    severity = 'severe'\n\nreturn [{\n    'json': {\n        **_input.first().json,\n        'score': score,\n        'severity': severity,\n    }\n}]"
      },
      "id": "code-pcl5",
      "name": "Analyze: PCL-5 (Python, TODO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 60]
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# TODO: real Mini-Mult (abbreviated MMPI) scoring.\n# Requires the actual scale/key mapping -- not committed to this repo\n# (see issue #1). Placeholder only.\nanswers = _input.first().json.get('answers', {})\nscore = sum(int(v) for v in answers.values()) if answers else 0\nseverity = 'low' if score < 20 else 'moderate' if score < 33 else 'high' if score < 50 else 'severe'\n\nreturn [{'json': {**_input.first().json, 'score': score, 'severity': severity}}]"
      },
      "id": "code-minmult",
      "name": "Analyze: Mini-Mult (Python, TODO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 260]
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# TODO: real Schmieschek (Leonhard-Schmieschek accentuation) scoring.\n# Requires the actual per-scale key/multiplier mapping -- not committed\n# to this repo (see issue #1). Placeholder only.\nanswers = _input.first().json.get('answers', {})\nscore = sum(int(v) for v in answers.values()) if answers else 0\nseverity = 'low' if score < 20 else 'moderate' if score < 33 else 'high' if score < 50 else 'severe'\n\nreturn [{'json': {**_input.first().json, 'score': score, 'severity': severity}}]"
      },
      "id": "code-schmishek",
      "name": "Analyze: Schmishek (Python, TODO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 460]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO results\n    (submission_id, token, full_name, test_type, score, severity, answers, status)\nVALUES\n    (gen_random_uuid(), $1, $2, $3, $4, $5, $6::jsonb, 'notified')\nRETURNING submission_id",
        "options": {
          "queryReplacement": "={{ [$json.token, $json.full_name, $json.test_type, $json.score, $json.severity, JSON.stringify($json.answers)] }}"
        }
      },
      "id": "postgres-insert-result",
      "name": "Save result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-320, 260],
      "credentials": {
        "postgres": { "id": "1", "name": "Postgres account" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tokens\nSET status = 'completed', used = TRUE, used_at = NOW()\nWHERE token = $1",
        "options": {
          "queryReplacement": "={{ [$json.token] }}"
        }
      },
      "id": "postgres-mark-completed",
      "name": "Mark token completed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-100, 260],
      "credentials": {
        "postgres": { "id": "1", "name": "Postgres account" }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "=✅ *{{ $json.full_name }}* completed the *{{ $json.test_type }}* test.\nScore: {{ $json.score }}\nSeverity: {{ $json.severity }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-notify",
      "name": "Notify doctor (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [120, 260],
      "credentials": {
        "telegramApi": { "id": "2", "name": "Telegram account" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"score\": $json.score, \"severity\": $json.severity } }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond: success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [340, 260]
    }
  ],
